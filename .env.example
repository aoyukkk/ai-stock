APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_LOG_LEVEL=INFO

# Safety: real trading is disabled by default in V0.3 phase 1.
ENABLE_REAL_TRADING=false
REAL_TRADING_BROKER_PROVIDER=disabled
AI_AUTO_REAL_ORDER_ENABLED=false
REQUIRE_HUMAN_CONFIRMATION=true

DATABASE_URL=sqlite:///./data/ai_trader_dev.db
REDIS_URL=redis://localhost:6379/0
CHROMA_PATH=./data/chroma
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_ENABLED=false

DEEPSEEK_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
SEARXNG_BASE_URL=
# Opt-in only. The test suite and normal startup never make real LLM calls.
RUN_REAL_LLM_SMOKE=false
RUN_REAL_LLM_SCREENING=false
RUN_REAL_FUNDAMENTAL_RESEARCH=false
DEEPSEEK_WEB_SEARCH_ENABLED=false
SEARCH_REAL_CALLS_ENABLED=false
SEARCH_PROVIDER_MODE=deepseek_unverified
ENABLE_TAVILY_SEARCH=false
ENABLE_BRAVE_SEARCH=false
ENABLE_SEARXNG_SEARCH=false
ENABLE_LLM_UNVERIFIED_RESEARCH_FALLBACK=true
LLM_REAL_CALLS_ENABLED=false
REAL_LLM_SAMPLE_SIZE=3
REAL_LLM_SAMPLE_MAX=5
OPENAI_API_KEY=
CLAUDE_API_KEY=
QWEN_API_KEY=

IFIND_USERNAME=
IFIND_PASSWORD=
IFIND_API_KEY=
IFIND_ACCESS_TOKEN=
IFIND_REFRESH_TOKEN=
IFIND_HTTP_ENABLED=false
RUN_REAL_IFIND_PROBE=false
TUSHARE_TOKEN=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

FRONTEND_DEV_SERVER=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Internal web server deployment. Keep Cloudflare API/Tunnel tokens out of this file.
APP_RUNTIME_MODE=DESKTOP
APP_PUBLIC_HOSTNAME=
APP_ORIGIN_HOST=127.0.0.1
APP_ORIGIN_PORT=8080
AUTH_MODE=LOCAL_SHARED_PASSWORD
SHARED_LOGIN_USERNAME=partners
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_TUNNEL_NAME=ai-trader-internal
CLOUDFLARE_ACCESS_SESSION_HOURS=12
ALLOWED_USER_EMAILS=
# Only used by Cloudflare Access modes. Shared-password mode creates one ADMIN identity.
INTERNAL_USER_ROLES={}
ENABLE_LOCAL_PASSWORD_AUTH=false
ALLOW_LOCAL_AUTH_BYPASS=false
SCHEDULER_ENABLED=false
SQLITE_BUSY_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=10485760
