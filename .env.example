APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_LOG_LEVEL=INFO

# Safety: real trading is disabled by default in V0.3 phase 1.
ENABLE_REAL_TRADING=false
REAL_TRADING_BROKER_PROVIDER=disabled
AI_AUTO_REAL_ORDER_ENABLED=false
REQUIRE_HUMAN_CONFIRMATION=true

DATABASE_URL=sqlite:///./data/ai_trader_dev.db
REDIS_URL=redis://localhost:6379/0
CHROMA_PATH=./data/chroma
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_ENABLED=false

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
QWEN_API_KEY=

IFIND_USERNAME=
IFIND_PASSWORD=
IFIND_API_KEY=
TUSHARE_TOKEN=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

FRONTEND_DEV_SERVER=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
